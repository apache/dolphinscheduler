        <mxCell id="note-1" value="Datasource and namespace grants attach to users; worker groups already have a separate project association." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1523" width="1240" height="30" />
        </mxCell>
        <mxCell id="note-2" value="Other resources use their existing ownership, project fields or type-specific query and operation rules." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1556" width="1240" height="30" />
        </mxCell>
        <mxCell id="note-3" value="The flow summarizes endpoint-dependent checks; there is no common project-resource grant contract for all eight types." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1589" width="1240" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
