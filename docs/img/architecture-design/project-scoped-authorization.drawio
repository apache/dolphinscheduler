        <mxCell id="section2" value="02   ENFORCE AT PROTECTED API / SERVICE ENTRY POINTS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=20;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=left;fontColor=#172B4D;fontStyle=1;spacing=0;" vertex="1" parent="1">
