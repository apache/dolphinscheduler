          <mxGeometry as="geometry" x="58" y="1452" width="1244" height="32" />
        </mxCell>
        <mxCell id="note-0" value="Project selectors filter in SQL and return safe metadata; use grants confer no edit / delete / re-grant rights." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1490" width="1240" height="30" />
        </mxCell>
        <mxCell id="note-1" value="System admins pass the operation check; required resource grants still apply. Child workflows use their own project." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1523" width="1240" height="30" />
        </mxCell>
        <mxCell id="note-2" value="Resource files retain existing authorization. Running / queued instances, scheduled triggers and retries are not rechecked." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
