        </mxCell>
        <mxCell id="entrypoints" value="Workflow / task configuration · publication · schedule management · manual execution / rerun&lt;br/&gt;Resource checks apply to the resources actually referenced by each operation." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=left;fontColor=#52657D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="728" width="1280" height="48" />
        </mxCell>
        <mxCell id="resolve" value="&lt;b&gt;Resolve project P&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Validate target project;&lt;br/&gt;use the actual project&lt;br/&gt;of an existing instance." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=#F1F5F9;strokeColor=#B6C4D5;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="818" width="255" height="142" />
        </mxCell>
        <mxCell id="operation-check" value="&lt;b&gt;Check operation&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;User has the required&lt;br/&gt;permission in project P?&lt;br/&gt;System admin passes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=#EAF0FE;strokeColor=#8CAAE7;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="345" y="818" width="270" height="142" />
        </mxCell>
        <mxCell id="resource-check" value="&lt;b&gt;Check referenced resources&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every required resource&lt;br/&gt;is granted to project P?&lt;br/&gt;Use grants are project-scoped." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=#E7F5EC;strokeColor=#86BA98;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="665" y="818" width="345" height="142" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;ALLOW&lt;/b&gt;&lt;br/&gt;Both dimensions pass" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=25;fillColor=#DCF2E3;strokeColor=#73AC88;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="845" width="250" height="86" />
        </mxCell>
        <mxCell id="resolve-operation" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#2563EB;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="resolve" target="operation-check">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="operation-resource" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#2563EB;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="operation-check" target="resource-check">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="resource-allow" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#15803D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="resource-check" target="allow">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;DENY&lt;/b&gt;  ·  Missing operation permission or required resource grant" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=#FEF2F2;strokeColor=#E2A3A3;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="345" y="1023" width="665" height="64" />
        </mxCell>
        <mxCell id="operation-deny" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="operation-check" target="deny">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="resource-deny" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="resource-check" target="deny">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="grant-note" value="System admins pass the operation check; required project resource grants still apply.&lt;br/&gt;Nested subworkflows are checked against each child workflow's own project and resource grants." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=20;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=center;fontColor=#52657D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1098" width="1280" height="60" />
        </mxCell>
        <mxCell id="section3" value="03   SCOPE AND UPGRADE BOUNDARIES" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=20;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=left;fontColor=#172B4D;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1170" width="1280" height="32" />
        </mxCell>
        <mxCell id="access-boundary" value="&lt;b&gt;Resource use and visibility&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Use grants do not grant edit / delete / re-grant rights.&lt;br/&gt;Project selectors filter in SQL and return safe metadata.&lt;br/&gt;Resource files retain the existing authorization model;&lt;br/&gt;they are outside this project-resource grant model." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=20;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1221" width="610" height="156" />
        </mxCell>
        <mxCell id="lifecycle-boundary" value="&lt;b&gt;Revocation and existing activity&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;No grant recheck for running / queued instances,&lt;br/&gt;scheduled triggers or automatic retries.&lt;br/&gt;Revocation does not stop instances or disable schedules." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=20;fillColor=#FFF9ED;strokeColor=#E4C790;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="1221" width="640" height="156" />
        </mxCell>
        <mxCell id="migration" value="&lt;b&gt;Upgrade to 3.5.0:&lt;/b&gt; legacy authorization data is retained; no automatic migration or legacy fallback.&lt;br/&gt;Administrators must explicitly reassign project member permissions and project resource grants." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#172B4D;fontSize=21;fillColor=#F1F5F9;strokeColor=#B6C4D5;strokeWidth=1.5;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1402" width="1280" height="74" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
