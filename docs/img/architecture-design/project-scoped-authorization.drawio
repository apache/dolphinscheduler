        </mxCell>
        <mxCell id="note-3" value="3.5.0 upgrade: retain legacy data; no automatic migration or fallback. Explicitly reassign both kinds of grants." style="html=0;whiteSpace=wrap;fontFamily=Helvetica Neue,PingFang SC;fontColor=#343434;fontSize=19;strokeColor=#9c9c9c;strokeWidth=1.3;sketch=0;shadow=0;rounded=1;absoluteArcSize=1;arcSize=8;fillColor=none;align=center;verticalAlign=middle;spacing=8;strokeColor=none;spacing=0;align=left;fontStyle=0;" vertex="1" parent="1">
