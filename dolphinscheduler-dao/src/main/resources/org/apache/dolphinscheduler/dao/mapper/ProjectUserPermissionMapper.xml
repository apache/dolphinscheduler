<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.apache.dolphinscheduler.dao.mapper.ProjectUserPermissionMapper">
    <sql id="baseSql">
        id, project_code, user_id, permission, create_time
    </sql>

    <select id="queryByProjectsAndUser" resultType="org.apache.dolphinscheduler.dao.entity.ProjectUserPermission">
        select <include refid="baseSql"/>
        from t_ds_project_user_permission
        where user_id = #{userId}
        and project_code in
        <foreach collection="projectCodes" item="projectCode" open="(" close=")" separator=",">
            #{projectCode}
        </foreach>
    </select>

    <select id="countPermission" resultType="java.lang.Integer">
        select count(1)
        from t_ds_project_user_permission
        where project_code = #{projectCode} and user_id = #{userId} and permission = #{permission}
    </select>

    <select id="queryByProjectAndUser" resultType="org.apache.dolphinscheduler.dao.entity.ProjectUserPermission">
        select <include refid="baseSql"/>
        from t_ds_project_user_permission
        where project_code = #{projectCode} and user_id = #{userId}
    </select>

    <delete id="revokeAllPermissions">
        delete from t_ds_project_user_permission
        where project_code = #{projectCode} and user_id = #{userId}
    </delete>

    <delete id="revokePermission">
        delete from t_ds_project_user_permission
        where project_code = #{projectCode} and user_id = #{userId} and permission = #{permission}
    </delete>
</mapper>
